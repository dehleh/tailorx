{
  "expo": {
    "name": "Tailor-X",
    "slug": "tailor-x",
    "scheme": "tailorxfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1D2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tailorx.app",
      "associatedDomains": [
        "applinks:tailorxfit.com",
        "applinks:www.tailorxfit.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Tailor-X needs camera access to scan your body for accurate measurements.",
        "NSPhotoLibraryUsageDescription": "Tailor-X needs photo library access to save and retrieve measurement photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand-adaptive-icon.png",
        "backgroundColor": "#0B1D2E"
      },
      "package": "com.tailorx.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tailorxfit.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.tailorxfit.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand-favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tailor-X to access your camera for body measurement scanning."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bcded85f-e28b-41c6-9b12-29915ba94a2f"
      }
    },
    "owner": "tailor-xs-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bcded85f-e28b-41c6-9b12-29915ba94a2f"
    }
  }
}
